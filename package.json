{
  "name": "m3-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "an unofficial skill for Material Design 3 (repository tooling)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tools/**/*.test.mjs\"",
    "guard": "node tools/guard/check-public-diff.mjs",
    "extract:scrape": "node tools/extract/scrape/run.mjs",
    "extract:sources": "node tools/extract/sources/fetch.mjs",
    "extract:tokens": "node tools/extract/tokens/report.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
