private class StepFailure(message: String) : Exception(message)

private class Sel(val kind: String, val value: String, val index: Int) {
    override fun toString() = "$kind \"$value\"" + (if (index > 0) " (index $index)" else "")
}

@RunWith(RobolectricTestRunner::class)
@GraphicsMode(GraphicsMode.Mode.NATIVE)
@Config(sdk = [36], qualifiers = "w412dp-h915dp-420dpi")
class M3ShotsTest {

    @Test
    fun light() = frames("light")

    @Test
    @Config(qualifiers = "+night")
    fun dark() = frames("dark")

    @Test
    fun stateLight() = states("light")

    @Test
    @Config(qualifiers = "+night")
    fun stateDark() = states("dark")

    private val outDir: File
        get() = File(requireNotNull(System.getProperty("m3.outDir")) { "m3.outDir is not set" }).also { it.mkdirs() }

    // ---- main frames ------------------------------------------------------------------------

    private fun frames(theme: String) {
        val context = ApplicationProvider.getApplicationContext<Context>()
        val intent = launchIntent(context)
        prepare(context)
        launched(intent) { scenario ->
            settle(SETTLE_FRAMES)
            val frames = JSONArray()
            var truncated = false
            for (i in 1..MAX_FRAMES) {
                lateinit var root: View
                scenario.onActivity { root = it.window.decorView }
                val file = "$theme-$VIEWPORT-" + i.toString().padStart(2, '0') + ".png"
                val png = File(outDir, file)
                root.captureRoboImage(png.absolutePath)
                check(png.isFile) { "Roborazzi did not write $png (is roborazzi.test.record=true set?)" }
                val frame = JSONObject().put("frame", i).put("file", file)
                try {
                    frame.put("results", runAtf(root, png))
                } catch (t: Throwable) {
                    frame.put("results", JSONArray()).put("atfError", t.toString())
                }
                try {
                    frame.put("semanticsTargets", semanticsTargets(root))
                } catch (t: Throwable) {
                    frame.put("semanticsTargets", JSONArray()).put("semanticsError", t.toString())
                }
                frames.put(frame)
                val sc = scrollable(listOf(root), forward = true) ?: break
                if (i == MAX_FRAMES) { truncated = true; break }
                val before = sc.config.getOrNull(SemanticsProperties.VerticalScrollAxisRange)!!.value()
                scrollBy(sc, sc.size.height.toFloat())
                settle(SCROLL_FRAMES)
                val moved = scrollable(listOf(root), any = true)?.config?.getOrNull(SemanticsProperties.VerticalScrollAxisRange)?.value()
                if (moved == null || moved <= before) break
            }
            File(outDir, "runtime-$theme.json").writeText(
                JSONObject().put("theme", theme).put("activity", intent.component?.className)
                    .put("sdk", Build.VERSION.SDK_INT).put("truncated", truncated).put("frames", frames).toString(2),
            )
        }
    }

    // ---- interaction states -----------------------------------------------------------------

    private fun states(theme: String) {
        val path = System.getProperty("m3.statesFile")?.takeIf { it.isNotBlank() } ?: return
        val specs = JSONObject(File(path).readText()).getJSONArray("states")
        val context = ApplicationProvider.getApplicationContext<Context>()
        val intent = launchIntent(context)
        prepare(context)
        for (i in 0 until specs.length()) {
            val spec = specs.getJSONObject(i)
            val name = spec.getString("name")
            if (File(outDir, "state-$name-$theme.json").exists()) continue
            val rec = JSONObject().put("name", name).put("theme", theme).put("ok", true)
            val watchdog = stateWatchdog(rec, name, theme)
            try {
                launched(intent) { scenario ->
                    settle(SETTLE_FRAMES)
                    lateinit var root: View
                    scenario.onActivity { root = it.window.decorView }
                    val steps = spec.getJSONArray("steps")
                    for (j in 0 until steps.length()) {
                        val step = steps.getJSONObject(j)
                        try {
                            runStep(step, root)
                        } catch (e: StepFailure) {
                            rec.put("ok", false).put("error", "step ${j + 1} ${step.keys().next()}: ${e.message}")
                            break
                        } catch (t: Throwable) {
                            rec.put("ok", false).put("error", "step ${j + 1} ${step.keys().next()}: $t")
                            break
                        }
                        settle(STEP_FRAMES)
                    }
                    if (rec.getBoolean("ok")) {
                        settle(STEP_FRAMES)
                        val file = "state-$name-$theme-$VIEWPORT.png"
                        val png = File(outDir, file)
                        captureWindows(root, png)
                        if (png.isFile) rec.put("file", file) else rec.put("ok", false).put("error", "no picture was written")
                    }
                }
            } catch (t: Throwable) {
                rec.put("ok", false).put("error", "state did not run: $t")
            }
            watchdog.interrupt()
            File(outDir, "state-$name-$theme.json").writeText(rec.toString(2))
            if (frameCapped && i < specs.length() - 1) {
                // An animation frame loop outlived the state (a menu popup started it): the next launch would
                // never return. The result is written; compose.mjs runs the remaining states in a new JVM.
                Runtime.getRuntime().halt(3)
            }
            File(outDir, "state-$name-$theme.json").writeText(rec.toString(2))
        }
    }

    private fun runStep(step: JSONObject, root: View) {
        when {
            step.has("click") -> click(sel(step.getJSONObject("click"), listOf("text", "tag", "desc")), root)
            step.has("enterText") -> {
                val o = step.getJSONObject("enterText")
                enterText(sel(o.getJSONObject("into"), listOf("text", "tag", "hint")), o.getString("text"), root)
            }
            step.has("scrollTo") -> scrollTo(sel(step.getJSONObject("scrollTo"), listOf("text", "tag", "desc")), root)
            step.has("waitMs") -> settle(((step.getDouble("waitMs") / 16.0).toInt() + 1).coerceIn(1, 2000))
            else -> throw StepFailure("unknown step")
        }
    }

    private fun sel(o: JSONObject, kinds: List<String>): Sel {
        val kind = kinds.firstOrNull { o.has(it) } ?: throw StepFailure("no finder (" + kinds.joinToString() + ")")
        return Sel(kind, o.getString(kind), o.optInt("index", 0))
    }

    private fun click(s: Sel, root: View) {
        val node = findAll(s, root).getOrNull(s.index) ?: throw StepFailure("nothing matches $s")
        var target: SemanticsNode? = node
        while (target != null && SemanticsActions.OnClick !in target.config) target = target.parent
        val t = target ?: throw StepFailure("$s has no click action")
        if (SemanticsProperties.Disabled in t.config) throw StepFailure("$s is disabled")
        val action = t.config.getOrNull(SemanticsActions.OnClick)?.action ?: throw StepFailure("$s has no click action")
        if (!action()) throw StepFailure("$s did not accept the click")
    }

    private fun enterText(s: Sel, text: String, root: View) {
        val field = findAll(s, root).mapNotNull { settable(it) }.getOrNull(s.index) ?: throw StepFailure("no text field matches $s")
        runCatching { field.config.getOrNull(SemanticsActions.RequestFocus)?.action?.invoke() }
        val set = field.config.getOrNull(SemanticsActions.SetText)?.action ?: throw StepFailure("$s is not a text field")
        if (!set(AnnotatedString(text))) throw StepFailure("$s did not accept the text")
    }

    // The node itself, a descendant or an ancestor that takes text.
    private fun settable(n: SemanticsNode): SemanticsNode? {
        if (SemanticsActions.SetText in n.config) return n
        val stack = ArrayDeque<SemanticsNode>().apply { addAll(n.children) }
        while (stack.isNotEmpty()) {
            val c = stack.removeFirst()
            if (SemanticsActions.SetText in c.config) return c
            stack.addAll(c.children)
        }
        var p = n.parent
        while (p != null) {
            if (SemanticsActions.SetText in p.config) return p
            p = p.parent
        }
        return null
    }

    private fun scrollTo(s: Sel, root: View) {
        val height = root.height
        var seenOffscreen = false
        var note = ""
        var dir = 1f
        var flipped = false
        for (attempt in 0 until MAX_SCROLL_STEPS) {
            redraw(root)
            val node = findAll(s, root).getOrNull(s.index)
            if (node != null) {
                // boundsInWindow is clipped by the scrollable: an empty or cut-off rectangle means off screen
                val b = node.boundsInWindow
                if (b.height >= node.size.height - 1f && b.top >= 0f && b.bottom <= height) return
                seenOffscreen = true
            }
            val sc = scrollable(windowRoots(root), any = true)
                ?: throw StepFailure(if (node == null) "nothing matches $s and nothing scrolls" else "$s is off screen and nothing scrolls")
            val range = sc.config.getOrNull(SemanticsProperties.VerticalScrollAxisRange)!!
            val before = range.value()
            scrollBy(sc, dir * sc.size.height * 0.6f)
            settle(SCROLL_FRAMES)
            redraw(root)
            val after = scrollable(windowRoots(root), any = true)?.config?.getOrNull(SemanticsProperties.VerticalScrollAxisRange)?.value() ?: before
            note = " (scroll position $before -> $after of ${range.maxValue()})"
            if (after == before) {
                // at the end: the target may be above
                if (flipped) break
                flipped = true
                dir = -dir
            }
        }
        throw StepFailure(if (seenOffscreen) "$s could not be scrolled into view$note" else "nothing matches $s")
    }

    // Compose measures and lays out inside the view's draw pass, which Robolectric does not run on its own:
    // without a draw, node positions stay at the last captured layout.
    private fun redraw(root: View) {
        val bitmap = android.graphics.Bitmap.createBitmap(1, 1, android.graphics.Bitmap.Config.ARGB_8888)
        runCatching { root.draw(android.graphics.Canvas(bitmap)) }
        bitmap.recycle()
    }

    // ---- semantics --------------------------------------------------------------------------

    // Root views of every window (dialogs and popups included), topmost first.
    private fun windowRoots(activityRoot: View): List<View> {
        val found = mutableListOf<View>()
        try {
            val cls = Class.forName("android.view.WindowManagerGlobal")
            val inst = cls.getMethod("getInstance").invoke(null)
            @Suppress("UNCHECKED_CAST")
            val names = cls.getMethod("getViewRootNames").invoke(inst) as Array<String>
            val get = cls.getMethod("getRootView", String::class.java)
            for (n in names) (get.invoke(inst, n) as? View)?.let { found += it }
        } catch (_: Throwable) {
            // fall back to the activity window
        }
        if (found.none { it === activityRoot }) found += activityRoot
        return found.reversed()
    }

    private fun composeRoots(view: View): List<ViewRootForTest> {
        val found = mutableListOf<ViewRootForTest>()
        fun visit(v: View) {
            if (v is ViewRootForTest) found += v
            if (v is ViewGroup) for (i in 0 until v.childCount) visit(v.getChildAt(i))
        }
        visit(view)
        return found
    }

    private fun flatten(root: SemanticsNode): List<SemanticsNode> {
        val out = mutableListOf<SemanticsNode>()
        val stack = ArrayDeque<SemanticsNode>().apply { add(root) }
        while (stack.isNotEmpty()) {
            val n = stack.removeFirst()
            out += n
            // document order: children before siblings
            n.children.reversed().forEach { stack.addFirst(it) }
        }
        return out
    }

    private fun nodes(views: List<View>, merged: Boolean): List<SemanticsNode> =
        views.flatMap { composeRoots(it) }.flatMap { r ->
            runCatching { flatten(if (merged) r.semanticsOwner.rootSemanticsNode else r.semanticsOwner.unmergedRootSemanticsNode) }
                .getOrDefault(emptyList())
        }

    private fun matches(n: SemanticsNode, s: Sel): Boolean {
        val c = n.config
        val texts = c.getOrNull(SemanticsProperties.Text)?.map { it.text }.orEmpty()
        return when (s.kind) {
            "text" -> s.value in texts || c.getOrNull(SemanticsProperties.EditableText)?.text == s.value
            "hint" -> s.value in texts || c.getOrNull(SemanticsProperties.ContentDescription)?.contains(s.value) == true
            "desc" -> c.getOrNull(SemanticsProperties.ContentDescription)?.contains(s.value) == true
            "tag" -> c.getOrNull(SemanticsProperties.TestTag) == s.value
            else -> false
        }
    }

    // Matches in the merged tree of the windows, topmost window first; none there: in the unmerged tree.
    private fun findAll(s: Sel, root: View): List<SemanticsNode> {
        val views = windowRoots(root)
        val merged = nodes(views, true).filter { matches(it, s) }
        if (merged.isNotEmpty()) return merged
        return nodes(views, false).filter { matches(it, s) }
    }

    // First vertical scrollable of the given windows (that can still move forward, or any).
    private fun scrollable(views: List<View>, forward: Boolean = false, any: Boolean = false): SemanticsNode? =
        nodes(views, true).firstOrNull { n ->
            val r = n.config.getOrNull(SemanticsProperties.VerticalScrollAxisRange)
            r != null && SemanticsActions.ScrollBy in n.config && (any || (forward && r.value() < r.maxValue()))
        }

    private fun scrollBy(n: SemanticsNode, dy: Float) {
        val action = n.config.getOrNull(SemanticsActions.ScrollBy)?.action ?: throw StepFailure("the scrollable has no scroll action")
        action(0f, dy)
    }

    // Every clickable Compose node (merged semantics tree) whose layout size is under 48x48dp.
    // ATF alone misses these: Compose reports the touch area it extends to 48dp as the node's
    // accessibility bounds. Disabled nodes carry enabled=false; compose.mjs leaves them out.
    private fun semanticsTargets(root: View): JSONArray {
        val out = JSONArray()
        val density = root.resources.displayMetrics.density
        val minPx = MIN_TARGET_DP * density
        for (node in nodes(listOf(root), true)) {
            val config = node.config
            if (SemanticsActions.OnClick !in config && SemanticsActions.OnLongClick !in config) continue
            val w = node.size.width
            val h = node.size.height
            if (w + 0.5f >= minPx && h + 0.5f >= minPx) continue
            val b = node.boundsInWindow
            val label = config.getOrNull(SemanticsProperties.ContentDescription)?.joinToString(" ")
                ?: config.getOrNull(SemanticsProperties.Text)?.joinToString(" ") { it.text }
            out.put(
                JSONObject()
                    .put("label", label)
                    .put("role", config.getOrNull(SemanticsProperties.Role)?.toString())
                    .put("enabled", SemanticsProperties.Disabled !in config)
                    .put("widthDp", Math.round(w / density * 10) / 10.0)
                    .put("heightDp", Math.round(h / density * 10) / 10.0)
                    .put("bounds", JSONArray(listOf(b.left.toInt(), b.top.toInt(), b.right.toInt(), b.bottom.toInt()))),
            )
        }
        return out
    }

    // ---- launch, motion, ATF ----------------------------------------------------------------

    // The class name compose.mjs found in AndroidManifest.xml, else the merged manifest's launcher.
    private fun launchIntent(context: Context): Intent {
        val name = System.getProperty("m3.launcher")?.takeIf { it.isNotBlank() }
        if (name != null) {
            return Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER).setClassName(context.packageName, name)
        }
        return requireNotNull(context.packageManager.getLaunchIntentForPackage(context.packageName)) {
            "no launcher activity in the merged manifest of ${context.packageName}"
        }
    }

    // Reduced motion: animator duration scale 0, which Compose reads as its MotionDurationScale.
    // Robolectric runs each vsync inside idle(), so an endless animation would keep the launch busy
    // until the heap ran out. Trace recording is off for the same reason (Compose traces every
    // recomposition and ShadowTrace keeps them all).
    private fun prepare(context: Context) {
        try {
            android.os.Trace::class.java.getDeclaredMethod("setAppTracingAllowed", Boolean::class.javaPrimitiveType)
                .apply { isAccessible = true }
                .invoke(null, false)
        } catch (_: Throwable) {
            // settle() resets the queue every frame anyway
        }
        ShadowTrace.reset()
        Settings.Global.putFloat(context.contentResolver, Settings.Global.ANIMATOR_DURATION_SCALE, 0f)
        runCatching { android.animation.ValueAnimator::class.java.getMethod("setDurationScale", Float::class.javaPrimitiveType).invoke(null, 0f) }
    }

    // Launches the activity, runs the body, then finishes the activity and lets the looper run a few frames.
    // ActivityScenario.close() is not used: it waits for the main looper to go idle, which never happens
    // while a Compose animation frame loop runs (found with a DropdownMenu popup on screen: the test JVM
    // spun until it was killed).
    private fun <T> launched(intent: Intent, body: (ActivityScenario<android.app.Activity>) -> T): T {
        val scenario = ActivityScenario.launch<android.app.Activity>(intent)
        var activity: android.app.Activity? = null
        scenario.onActivity { activity = it }
        try {
            return body(scenario)
        } finally {
            val a = activity
            if (a != null) {
                // Dialogs and popups first: a popup that stays up keeps its animation frame loop running into the
                // next launch.
                val decor = a.window.decorView
                for (w in windowRoots(decor)) {
                    if (w !== decor) runCatching { a.windowManager.removeViewImmediate(w) }
                }
                runCatching { a.finish() }
            }
            settle(STEP_FRAMES)
        }
    }

    // The state picture: the activity window with every other window (dialog, bottom sheet, menu popup)
    // drawn over it, bottom first, with the dim a window asks for. Drawn here with View.draw on a bitmap
    // canvas: Roborazzi's capture calls wait for the main looper to go idle (Espresso.onIdle), and that
    // never returns while a Compose animation frame loop runs (a menu popup started one).
    private fun captureWindows(activityRoot: View, png: File) {
        redraw(activityRoot)
        val views = windowRoots(activityRoot).reversed()
        val bitmap = Bitmap.createBitmap(activityRoot.width, activityRoot.height, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bitmap)
        for (v in views) {
            if (v !== activityRoot) redraw(v)
            if (v.width <= 0 || v.height <= 0) continue
            val params = v.layoutParams as? WindowManager.LayoutParams
            var x = 0
            var y = 0
            if (v !== activityRoot && params != null) {
                if ((params.flags and WindowManager.LayoutParams.FLAG_DIM_BEHIND) != 0 && params.dimAmount > 0f) {
                    canvas.drawRect(0f, 0f, bitmap.width.toFloat(), bitmap.height.toFloat(), Paint().apply { color = Color.argb((params.dimAmount * 255).toInt(), 0, 0, 0) })
                }
                // Robolectric reports no screen position: place the window by its gravity and offsets.
                val g = params.gravity
                x = when (g and Gravity.HORIZONTAL_GRAVITY_MASK) {
                    Gravity.CENTER_HORIZONTAL -> (bitmap.width - v.width) / 2 + params.x
                    Gravity.RIGHT, Gravity.END -> bitmap.width - v.width - params.x
                    else -> params.x
                }
                y = when (g and Gravity.VERTICAL_GRAVITY_MASK) {
                    Gravity.CENTER_VERTICAL -> (bitmap.height - v.height) / 2 + params.y
                    Gravity.BOTTOM -> bitmap.height - v.height - params.y
                    else -> params.y
                }
            }
            val save = canvas.save()
            canvas.translate(x.toFloat(), y.toFloat())
            v.draw(canvas)
            canvas.restoreToCount(save)
        }
        png.outputStream().use { bitmap.compress(Bitmap.CompressFormat.PNG, 100, it) }
    }

    // Advances the paused main looper by n frames of 16 ms: the clock moves, then the due tasks run, at most
    // MAX_TASKS_PER_FRAME of them. idleFor() would run every task that is due inside its window, and some
    // views (a DropdownMenu popup, for one) post a new task at once each time one runs: idleFor never
    // returned and the test JVM spun for hours: the Choreographer posts the next frame at the same instant
    // for as long as a Compose animation frame loop runs. A bounded frame leaves such a loop unfinished and
    // goes on (the clock still moves 16 ms per frame); one settle call also stops after SETTLE_BUDGET_MS.
    private fun settle(frames: Int) {
        val looper = shadowOf(Looper.getMainLooper())
        val deadline = System.nanoTime() + SETTLE_BUDGET_MS * 1_000_000L
        repeat(frames) {
            ShadowSystemClock.advanceBy(Duration.ofMillis(16))
            if (System.nanoTime() > deadline) return@repeat
            var n = 0
            while (!looper.isIdle && n < MAX_TASKS_PER_FRAME) {
                looper.runOneTask()
                n++
            }
            frameCapped = n >= MAX_TASKS_PER_FRAME
            if (n >= MAX_TASKS_PER_FRAME && !loopReported) {
                loopReported = true
                File(outDir, "settle-loop.txt").writeText(pendingMessages())
            }
            ShadowTrace.reset()
        }
    }

    private var loopReported = false

    // True when the last settled frame still had tasks due: an animation frame loop is running.
    private var frameCapped = false

    // The messages waiting in the main queue (what keeps a settle frame busy), for the log.
    private fun pendingMessages(): String = try {
        val queue = Looper.getMainLooper().queue
        val field = queue.javaClass.getDeclaredField("mMessages").apply { isAccessible = true }
        val sb = StringBuilder()
        var m = field.get(queue) as android.os.Message?
        var i = 0
        while (m != null && i < 12) {
            sb.append(m.toString()).append(" callback=").append(m.callback).append("\n")
            val next = android.os.Message::class.java.getDeclaredField("next").apply { isAccessible = true }
            m = next.get(m) as android.os.Message?
            i++
        }
        sb.toString()
    } catch (t: Throwable) {
        "pending messages unavailable: $t"
    }

    // Stops the JVM when one state takes longer than STATE_LIMIT_MS (a loop the bounded settle cannot see,
    // for example inside a step's own code): the state is recorded as failed first.
    private fun stateWatchdog(rec: JSONObject, name: String, theme: String): Thread = Thread {
        try {
            Thread.sleep(STATE_LIMIT_MS)
        } catch (_: InterruptedException) {
            return@Thread
        }
        rec.put("ok", false).put("error", "stalled for ${STATE_LIMIT_MS / 1000} s (an endless animation or a layout loop); the test JVM was stopped")
        File(outDir, "state-$name-$theme.json").writeText(rec.toString(2))
        Runtime.getRuntime().halt(3)
    }.apply { isDaemon = true; start() }

    private fun runAtf(root: View, png: File): JSONArray {
        val bitmap = requireNotNull(BitmapFactory.decodeFile(png.absolutePath)) { "cannot decode $png" }
        // ATF bails out on the "robolectric" fingerprint; Roborazzi uses the same workaround.
        val priorFingerprint = Build.FINGERPRINT
        ShadowBuild.setFingerprint("m3forge/shots")
        try {
            val checks = AccessibilityCheckPreset.getAccessibilityHierarchyChecksForPreset(AccessibilityCheckPreset.LATEST)
            val parameters = Parameters().apply { putScreenCapture(BitmapImage(bitmap)) }
            val results = ViewChecker().setObtainCharacterLocations(true).runChecksOnView(checks, root, parameters)
            val out = JSONArray()
            for (r in results) {
                if (r.type == AccessibilityCheckResultType.NOT_RUN) continue
                val e = r.element
                val item = JSONObject()
                    .put("check", r.sourceCheckClass.simpleName)
                    .put("type", r.type.name)
                    .put("message", r.getMessage(Locale.ENGLISH)?.toString())
                if (e != null) {
                    val b = e.boundsInScreen
                    item.put(
                        "element",
                        JSONObject()
                            .put("className", e.className?.toString())
                            .put("text", e.text?.toString())
                            .put("contentDescription", e.contentDescription?.toString())
                            .put("resourceName", e.resourceName)
                            .put("clickable", e.isClickable)
                            // Compose maps SemanticsProperties.Disabled to AccessibilityNodeInfo.isEnabled == false.
                            .put("enabled", e.isEnabled)
                            .put("bounds", JSONArray(listOf(b.left, b.top, b.right, b.bottom))),
                    )
                }
                out.put(item)
            }
            return out
        } finally {
            ShadowBuild.setFingerprint(priorFingerprint)
        }
    }

    private companion object {
        const val VIEWPORT = "412x915"
        const val SETTLE_FRAMES = 125
        const val SCROLL_FRAMES = 60
        const val STEP_FRAMES = 40
        const val MAX_FRAMES = 4
        const val MAX_TASKS_PER_FRAME = 100
        const val SETTLE_BUDGET_MS = 10_000L
        const val STATE_LIMIT_MS = 90_000L
        const val MAX_SCROLL_STEPS = 40
        const val MIN_TARGET_DP = 48f
    }
}
