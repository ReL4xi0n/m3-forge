// Generated by the material3 skill screenshot step into a temporary copy of the project: loads the
// real fonts before any test runs, so text and icons are not drawn as boxes.
//
// Inputs (environment variables set by the screenshot step):
//   M3_FONTS_DIR    the skill's assets/fonts folder (the step checks it against versions.json)
//   M3_CAPTURE_OUT  with it set, the loaded app font families are written to app-fonts.json there
//
// The app's own fonts come first (every family in the FontManifest.json that `flutter test` builds:
// fonts the app declares, MaterialIcons, package fonts). A family the app declares is not
// registered again from the skill fonts. Roboto is registered under every family name the
// framework's default typographies ask for.
import 'dart:async';
import 'dart:convert';
import 'dart:io';
import 'dart:typed_data';

import 'package:flutter/services.dart';
import 'package:flutter_test/flutter_test.dart';

const String m3RobotoFlex = 'Roboto Flex';
const String m3Symbols = 'Material Symbols Outlined';
const List<String> m3RobotoAliases = <String>[
  'Roboto',
  '.SF UI Text',
  '.SF UI Display',
  '.AppleSystemUIFont',
  'CupertinoSystemText',
  'CupertinoSystemDisplay',
  'FlutterTest',
];

Future<void> testExecutable(FutureOr<void> Function() testMain) async {
  TestWidgetsFlutterBinding.ensureInitialized();
  await m3LoadFonts();
  await testMain();
}

bool _loaded = false;

Future<void> m3LoadFonts() async {
  if (_loaded) return;
  final String dir = Platform.environment['M3_FONTS_DIR'] ?? (throw StateError('set M3_FONTS_DIR'));
  Uint8List read(String name) {
    final File file = File('$dir${Platform.pathSeparator}$name');
    if (!file.existsSync()) throw StateError('font missing: ${file.path}');
    return file.readAsBytesSync();
  }

  Future<void> register(String family, Uint8List bytes) async {
    final FontLoader loader = FontLoader(family)..addFont(Future<ByteData>.value(ByteData.sublistView(bytes)));
    await loader.load();
  }

  final Set<String> app = await m3LoadAppFonts();
  Future<void> ours(String family, Uint8List bytes) async {
    if (!app.contains(family)) await register(family, bytes);
  }

  await ours(m3RobotoFlex, read('RobotoFlex.ttf'));
  final Uint8List roboto = read('Roboto.ttf');
  for (final String alias in m3RobotoAliases) {
    await ours(alias, roboto);
  }
  await ours(m3Symbols, read('MaterialSymbolsOutlined.ttf'));
  _loaded = true;
}

Future<Set<String>> m3LoadAppFonts() async {
  final Set<String> families = <String>{};
  final List<Map<String, Object?>> report = <Map<String, Object?>>[];
  String? manifest;
  try {
    manifest = await rootBundle.loadString('FontManifest.json');
  } catch (_) {
    manifest = null;
  }
  if (manifest != null) {
    for (final dynamic entry in jsonDecode(manifest) as List<dynamic>) {
      final Map<String, dynamic> e = entry as Map<String, dynamic>;
      final String family = e['family'] as String;
      final FontLoader loader = FontLoader(family);
      final List<String> assets = <String>[];
      for (final dynamic f in (e['fonts'] as List<dynamic>? ?? <dynamic>[])) {
        final String asset = (f as Map<String, dynamic>)['asset'] as String;
        assets.add(asset);
        loader.addFont(rootBundle.load(asset));
      }
      await loader.load();
      families.add(family);
      report.add(<String, Object?>{'family': family, 'assets': assets});
    }
  }
  final String? out = Platform.environment['M3_CAPTURE_OUT'];
  if (out != null && out.isNotEmpty) {
    Directory(out).createSync(recursive: true);
    File('$out${Platform.pathSeparator}app-fonts.json').writeAsStringSync(
      const JsonEncoder.withIndent('  ').convert(<String, Object?>{'manifest': manifest != null, 'families': report}),
    );
  }
  return families;
}
